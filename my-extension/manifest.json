{
  "manifest_version": 3,
  "name": "Component Capture Tool",
  "version": "1.0",
  "description": "Select and capture HTML component info",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_title": "Capture Component"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["style.css"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["selector.js", "ui.js"],
      "matches": ["<all_urls>"]
    }
  ]
}